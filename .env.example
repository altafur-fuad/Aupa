# Example variable names only. Copy values from your local secret manager/env.
# Never put real production secrets in this file.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Server-only PostgreSQL connection (never place in Flutter).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Custom Aupa JWT settings; provide secret/key via a secret manager or protected env.
JWT_ISSUER=aupa-api
JWT_AUDIENCE=aupa-mobile
JWT_SIGNING_KEY=<local-development-only-placeholder>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Provider settings are intentionally blank until a provider is selected.
PAYMENT_PROVIDER=<not-selected>
SMS_PROVIDER=<not-selected>
PUSH_PROVIDER=<not-selected>
MAPS_PROVIDER=<not-selected>
